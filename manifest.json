{
  "manifest_version": 3,
  "name": "X Nuke DMs",
  "version": "0.2.6",
  "description": "Delete your own X direct-message conversations in bulk.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://chat.x.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Nuke DMs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://chat.x.com/*"],
      "js": ["inbox.js", "xchat.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://chat.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
